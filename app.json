{
  "expo": {
    "name": "Youmotion",
    "slug": "youmotion",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-ios.png",
    "scheme": "youmotion",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0E8",
    "buildCacheProvider": "eas",
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "bundleIdentifier": "com.youmotion.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "WL832FKGWX"
    },
    "android": {
      "icon": "./assets/images/app-icon-android.png",
      "package": "com.youmotion.mobile",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-no-push-entitlement",
      "expo-router",
      "expo-localization",
      "expo-mail-composer",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#5E6B52",
          "defaultChannel": "gentle-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0E8",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 156
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "ccacheEnabled": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f37690f-c632-408c-a4ab-1b240610bd12"
      }
    },
    "owner": "youmotion",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7f37690f-c632-408c-a4ab-1b240610bd12",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
