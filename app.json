{
  "expo": {
    "name": "Youmotion",
    "slug": "youmotion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-ios.png",
    "scheme": "youmotion",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0E8",
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "bundleIdentifier": "com.youmotion.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/app-icon-android.png",
      "package": "com.youmotion.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "ccacheEnabled": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f37690f-c632-408c-a4ab-1b240610bd12"
      }
    },
    "owner": "youmotion"
  }
}
