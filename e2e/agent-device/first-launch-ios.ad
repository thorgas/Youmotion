wait "id=\"onboarding-primary-action\" label=\"Show the example\""
press "id=\"onboarding-primary-action\" label=\"Show the example\""
wait "id=\"onboarding-primary-action\" label=\"Continue\""
press "id=\"onboarding-primary-action\" label=\"Continue\""
wait "id=\"onboarding-primary-action\" label=\"Try your first check-in\""
press "id=\"onboarding-primary-action\" label=\"Try your first check-in\""
wait "id=\"emotion-readout-prompt\""
