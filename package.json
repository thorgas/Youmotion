{
  "name": "youmotion",
  "main": "./entry.tsx",
  "version": "1.0.0",
  "packageManager": "pnpm@11.12.0",
  "dependencies": {
    "@callstack/inspector": "0.1.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/ui": "~57.0.4",
    "@ottrelite/backend-wrapper-tracy": "0.1.1",
    "@ottrelite/core": "0.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xstate/react": "^7.0.0-alpha.1",
    "@xstate/store": "^4.1.0",
    "@xstate/store-react": "^2.0.0",
    "effect": "^3.21.4",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "fbtee": "2.0.0",
    "pressto": "0.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-grab": "1.1.1",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-performance": "^6.0.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "xstate": "^6.0.0-alpha.20"
  },
  "devDependencies": {
    "@nkzw/babel-preset-fbtee": "2.0.0",
    "@react-native-harness/cli": "^1.3.0",
    "@react-native-harness/platform-android": "^1.3.0",
    "@react-native-harness/platform-apple": "^1.3.0",
    "@react-native-harness/platform-web": "^1.3.0",
    "@react-native-harness/runtime": "^1.3.0",
    "@react-native/jest-preset": "^0.86.0",
    "@rozenite/metro": "1.13.0",
    "@rozenite/performance-monitor-plugin": "1.13.0",
    "@rozenite/require-profiler-plugin": "1.13.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "agent-react-devtools": "0.4.0",
    "babel-preset-expo": "~57.0.2",
    "cali": "0.4.0-6",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "react-devtools-core": "^7.0.1",
    "react-doctor": "0.7.2",
    "react-native-harness": "^1.3.0",
    "reassure": "1.5.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "scripts": {
    "start": "expo start",
    "start:tools": "WITH_ROZENITE=true expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "cali:review": "cali review --quiet",
    "devtools:react": "agent-react-devtools start",
    "devtools:inspector": "inspector start",
    "doctor:react": "react-doctor --yes --no-telemetry --no-supply-chain",
    "i18n:all": "pnpm i18n:collect && pnpm i18n:compile",
    "i18n:collect": "fbtee collect",
    "i18n:compile": "fbtee translate --source-strings source_strings.json --translations translations/*.json --output-dir src/translations --output-locale-style=bcp47",
    "i18n:prepare": "fbtee prepare-translations --source-strings source_strings.json --output-dir translations --locales de-DE",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:rules": "jest oxlint-rules --runInBand --no-watchman",
    "perf:baseline": "reassure --baseline",
    "perf:measure": "reassure",
    "perf:stability": "reassure check-stability",
    "preios": "node scripts/prepare-tracy-ios.mjs",
    "prepare": "pnpm i18n:all",
    "tracy:android": "adb forward tcp:8086 tcp:8086",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:compat": "tsc --noEmit",
    "test": "jest --runInBand --no-watchman",
    "test:watch": "jest --watch --no-watchman",
    "test:coverage": "jest --coverage --runInBand --no-watchman",
    "test:harness": "harness --config jest.harness.config.mjs --no-watchman",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "private": true
}
