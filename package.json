{
  "name": "youmotion",
  "homepage": "https://youmotion.app/",
  "repository": { "type": "git", "url": "git+https://github.com/thorgas/Youmotion.git" },
  "bugs": { "url": "https://github.com/thorgas/Youmotion/issues" },
  "main": "./entry.tsx",
  "version": "1.0.1",
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@appduct/react-native": "0.14.0",
    "@babel/runtime": "7.29.7",
    "@callstack/inspector": "0.1.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/ui": "~57.0.16",
    "@ottrelite/backend-wrapper-tracy": "0.1.1",
    "@ottrelite/core": "0.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@ubjs/core": "0.31.0-3",
    "@wuba/react-native-echarts": "3.1.1",
    "@xstate/react": "^7.0.0-alpha.1",
    "@xstate/store": "^4.1.0",
    "@xstate/store-react": "^2.0.0",
    "echarts": "6.1.0",
    "effect": "^3.21.4",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-mail-composer": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-update-kit": "0.1.0-alpha.7",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "fbtee": "2.0.0",
    "pressto": "0.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-grab": "1.1.1",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-performance": "^6.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-surrealdb": "0.1.0-alpha.1",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tslib": "2.8.1",
    "uniffi-bindgen-react-native": "0.31.0-3",
    "xstate": "^6.0.0-alpha.20",
    "zrender": "6.1.0"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "0.9.2",
    "@expo/fingerprint": "~0.20.12",
    "@nkzw/babel-preset-fbtee": "2.0.0",
    "@react-native-harness/cli": "^1.3.0",
    "@react-native-harness/platform-android": "^1.3.0",
    "@react-native-harness/platform-apple": "^1.3.0",
    "@react-native-harness/platform-web": "^1.3.0",
    "@react-native-harness/runtime": "^1.3.0",
    "@react-native-harness/ui": "^1.3.0",
    "@react-native/jest-preset": "^0.86.0",
    "@rozenite/metro": "1.13.0",
    "@rozenite/performance-monitor-plugin": "1.13.0",
    "@rozenite/require-profiler-plugin": "1.13.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "agent-device": "0.20.0",
    "agent-react-devtools": "0.4.0",
    "appduct": "0.14.0",
    "babel-preset-expo": "~57.0.2",
    "cali": "0.4.0-6",
    "e2e": "0.18.0",
    "eas-build-cache-provider": "21.0.0",
    "eas-cli": "21.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-code-architecture": "0.6.0-alpha.11",
    "expo-no-push-entitlement": "1.0.0",
    "goldie": "0.3.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "react-devtools-core": "^7.0.1",
    "react-doctor": "0.7.2",
    "react-native-harness": "^1.3.0",
    "reassure": "1.5.1",
    "resolution-agent": "0.1.2",
    "skillgym": "0.10.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "scripts": {
    "clean": "pnpm exec expo prebuild --clean",
    "start": "expo start --dev-client",
    "start:e2e": "EXPO_PUBLIC_E2E=true expo start --dev-client --port 8091",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:tools": "WITH_ROZENITE=true expo start --dev-client",
    "android": "MOBILE_UPDATE_CHANNEL=none expo run:android",
    "ios": "MOBILE_UPDATE_CHANNEL=none expo run:ios",
    "install:release:android": "expo run:android --variant release --device --no-bundler",
    "install:release:ios": "pnpm preios && expo run:ios --configuration Release --device --no-bundler",
    "web": "expo start --web",
    "cali:review": "cali review --quiet",
    "devtools:react": "agent-react-devtools start",
    "devtools:inspector": "inspector start",
    "doctor:react": "react-doctor --yes --no-telemetry --no-supply-chain",
    "doctor:expo": "pnpm dlx expo-doctor@latest",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:init": "eas init",
    "eas:open": "eas open",
    "eas:credentials:ios": "eas credentials --platform ios",
    "eas:credentials:android": "eas credentials --platform android",
    "eas:builds": "eas build:list",
    "eas:update:configure": "eas update:configure",
    "eas:update:development": "eas update --channel development --environment development",
    "eas:update:qa": "expo-update-kit verify-runtime --app-dir . && eas update --channel qa --environment preview",
    "eas:update:production": "expo-update-kit verify-runtime --app-dir . && eas update --channel production --environment production",
    "eas:update:runtimes": "expo-update-kit verify-runtime --app-dir . --write",
    "build:dev": "eas build --platform all --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:simulator:ios": "eas build --platform ios --profile development-simulator",
    "build:preview": "eas build --platform all --profile preview",
    "build:qa": "eas build --platform all --profile qa",
    "build:qa:android": "eas build --platform android --profile qa",
    "build:qa:ios": "eas build --platform ios --profile qa",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:testing": "eas build --platform all --profile testing",
    "build:testing:android": "eas build --platform android --profile testing",
    "build:testing:ios": "eas build --platform ios --profile testing",
    "build:testflight:qa-controls": "eas build --platform ios --profile testing",
    "build:testflight:production": "eas build --platform ios --profile production",
    "build:production": "eas build --platform all --profile production",
    "build:production:android": "eas build --platform android --profile production",
    "build:production:ios": "eas build --platform ios --profile production",
    "submit:testflight": "eas submit --platform ios --profile production --latest",
    "submit:testflight:testing": "node scripts/submit-testing.mjs ios",
    "submit:testflight:qa-controls": "node scripts/submit-testing.mjs ios",
    "submit:play:internal": "eas submit --platform android --profile internal --latest",
    "submit:play:testing": "node scripts/submit-testing.mjs android",
    "submit:play:production": "eas submit --platform android --profile production --latest",
    "release:testing": "eas build --platform all --profile testing --no-wait",
    "release:testflight": "pnpm release:testflight:production",
    "release:testflight:qa-controls": "eas build --platform ios --profile testing --auto-submit",
    "release:testflight:production": "eas build --platform ios --profile production --auto-submit",
    "version:ios": "eas build:version:get --platform ios",
    "version:android": "eas build:version:get --platform android",
    "version:android:set": "eas build:version:set --platform android",
    "verify:ios:archive": "bash scripts/verify-ios-store-archive.sh",
    "verify:store-screenshots": "node scripts/verify-store-screenshot-provenance.mjs",
    "generate:store-screenshot-fixture": "node scripts/generate-store-screenshot-fixture.mjs",
    "capture:store-screenshots": "node scripts/store-screenshot-matrix.mjs",
    "test:store-screenshot-runner": "node --test scripts/store-screenshot-matrix.test.mjs",
    "verify:website": "node scripts/verify-website.mjs",
    "fingerprint:android": "fingerprint fingerprint:generate --platform android",
    "fingerprint:ios": "fingerprint fingerprint:generate --platform ios",
    "i18n:all": "pnpm i18n:collect && pnpm i18n:compile",
    "i18n:collect": "fbtee collect",
    "i18n:compile": "fbtee translate --source-strings source_strings.json --translations translations/*.json --output-dir src/translations --output-locale-style=bcp47",
    "i18n:prepare": "fbtee prepare-translations --source-strings source_strings.json --output-dir translations --locales de-DE",
    "lint": "pnpm lint:oxlint && pnpm lint:architecture",
    "lint:architecture": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "lint:rules": "jest oxlint-rules --runInBand --no-watchman",
    "perf:baseline": "reassure --baseline",
    "perf:measure": "reassure",
    "perf:stability": "reassure check-stability",
    "preios": "node scripts/prepare-tracy-ios.mjs",
    "prepare": "pnpm i18n:all",
    "capture:responsive:android": "resolution-agent capture --package com.youmotion.mobile --out-dir artifacts/resolution-agent",
    "capture:responsive:android:serve": "resolution-agent serve --dir artifacts/resolution-agent",
    "tracy:android": "adb forward tcp:8086 tcp:8086",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:compat": "tsc --noEmit",
    "test": "jest --runInBand --no-watchman",
    "test:watch": "jest --watch --no-watchman",
    "test:coverage": "jest --coverage --runInBand --no-watchman",
    "test:e2e": "node scripts/run-argent-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-argent-e2e.mjs --flow navigation-smoke.yaml",
    "test:e2e:release:android:locale:de": "E2E_EXPECTED_LOCALE=de-DE node scripts/run-android-release-locale-e2e.mjs",
    "test:e2e:release:android:locale:en": "E2E_EXPECTED_LOCALE=en-US node scripts/run-android-release-locale-e2e.mjs",
    "test:harness": "harness --config jest.harness.config.mjs --no-watchman",
    "test:harness:android": "node scripts/run-android-harness.mjs android 8084",
    "test:harness:android:pixel": "node scripts/run-android-harness.mjs android-pixel-6a 8084",
    "test:harness:ios": "RN_HARNESS_METRO_PORT=8083 harness --config jest.harness.config.mjs --no-watchman --harnessRunner ios",
    "prepare:harness:ios": "node scripts/prepare-ios-harness.mjs",
    "verify:commands": "node scripts/verify-commands.mjs",
    "verify": "pnpm verify:commands && pnpm lint && pnpm typecheck && pnpm verify:website && pnpm test",
    "test:e2e:appduct": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:e2e:appduct:list": "E2E_TELEMETRY_DISABLED=1 e2e list",
    "test:e2e:website": "E2E_TELEMETRY_DISABLED=1 e2e run --config e2e.website.config.ts"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@react-native-harness/ui"
        ]
      }
    }
  },
  "private": true
}
